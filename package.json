{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"npm run css:watch\" \"npm run dev:front\" \"npm run dev:chatbot\" \"npm run dev:dashboard\"",
        "dev:front": "vite --config vite.front.config.js",
        "dev:chatbot": "vite --config vite.chatbot.config.js",
        "dev:dashboard": "vite --config vite.dashboard.config.js",
        "css:watch": "tailwindcss -i ./resources/css/app.css -o ./public/build/app.css --watch --verbose",
        "css:build": "tailwindcss -i ./resources/css/app.css -o ./public/build/app.css --minify",
        "build:front": "vite build --config vite.front.config.js",
        "build:chatbot": "vite build --config vite.chatbot.config.js",
        "build:dashboard": "vite build --config vite.dashboard.config.js",
        "build": "npm run css:build && concurrently \"npm run build:front\" \"npm run build:chatbot\" \"npm run build:dashboard\""
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@tailwindcss/forms": "^0.5.3",
        "@tailwindcss/line-clamp": "^0.4.4",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.2",
        "autoprefixer": "^10.4.12",
        "axios": "^1.11.0",
        "concurrently": "^9.2.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.2.1",
        "vite": "^7.0.7",
        "vue": "^3.4.0"
    },
    "dependencies": {
        "mathlive": "^0.108.2"
    }
}
